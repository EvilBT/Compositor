    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像中拖动某个颜色，相邻色系会一起移动。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点。单击可添加，双击可删除。"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动。角度决定色相，距离决定饱和度。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖动以放置参考线。至少画两条线。"
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或滚动可移动视图；双击在“适合窗口”与 100% 之间切换"
          }
        }
      }
    },
    "Drag to resize the panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整面板大小"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可设置色相与饱和度。双击可复位该色轮。"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动可提升或压低这些色调。拖动底部的分隔点可改变各区域覆盖的色调范围。"
          }
        }
      }
    },
    "Draw Guides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制参考线"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个大像素画成实心方块，或像点阵屏那样的圆点"
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用暗色画出亮部标记，如同发光的屏幕"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
